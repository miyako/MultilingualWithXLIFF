<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file datatype="plaintext" original="LangageSwitching" source-language="en" target-language="ja">
    <body>
      <trans-unit id="AlertArabicSave" resname="AlertArabicSave">
        <source>The Arabic sample could not be saved.</source>
        <target>アラビア語のサンプルを保存できませんでした。</target>
      </trans-unit>
      <trans-unit id="...switch language dynamically?" resname="...switch language dynamically?">
        <source>...switch language dynamically?</source>
        <target>言語を動的に切り替えるには</target>
      </trans-unit>
      <trans-unit id="AlertArabicMissing" resname="AlertArabicMissing">
        <source>The Arabic sample is missing from Resources.</source>
        <target>Resourcesフォルダーにアラビア語のサンプルが見つかりません。</target>
      </trans-unit>
      <trans-unit id="AlertArabicRead" resname="AlertArabicRead">
        <source>The Arabic sample could not be read.</source>
        <target>アラビア語のサンプルを読み込めませんでした。</target>
      </trans-unit>
      <trans-unit id="AlertLanguageCode" resname="AlertLanguageCode">
        <source>Enter a language code: en, es, fr, de, it, or ja.</source>
        <target>言語コードを入力してください（en、es、fr、de、it、ja）。</target>
      </trans-unit>
      <trans-unit id="AlertLanguageUnavailable" resname="AlertLanguageUnavailable">
        <source>The requested language is not available in this demo.</source>
        <target>指定した言語はこのデモでは利用できません。</target>
      </trans-unit>
      <trans-unit id="All labels are automatically localized according to selected language" resname="All labels are automatically localized according to selected language">
        <source>All labels are automatically localized according to selected language</source>
        <target>すべてのラベルが選択した言語に応じて&#13;自動翻訳されます。</target>
      </trans-unit>
      <trans-unit id="Change Language" resname="Change Language">
        <source>Change Language</source>
        <target>言語の切り替え</target>
      </trans-unit>
      <trans-unit id="Current language : " resname="Current language : ">
        <source>Current language : </source>
        <target>現在の言語：</target>
      </trans-unit>
      <trans-unit id="Demo" resname="Demo">
        <source>Demo</source>
        <target>デモ</target>
      </trans-unit>
      <trans-unit id="Demo_WindowTitle" resname="Demo_WindowTitle">
        <source>XLIFF language switching</source>
        <target>XLIFFによる言語切り替え</target>
      </trans-unit>
      <trans-unit id="How Do I..." resname="How Do I...">
        <source>How Do I...</source>
        <target>操作ガイド</target>
      </trans-unit>
      <trans-unit id="LanguageDE" resname="LanguageDE">
        <source>German (de)</source>
        <target>ドイツ語（de）</target>
      </trans-unit>
      <trans-unit id="LanguageEN" resname="LanguageEN">
        <source>English (en-US)</source>
        <target>英語（en-US）</target>
      </trans-unit>
      <trans-unit id="LanguageES" resname="LanguageES">
        <source>Spanish (es)</source>
        <target>スペイン語（es）</target>
      </trans-unit>
      <trans-unit id="LanguageFR" resname="LanguageFR">
        <source>French (fr)</source>
        <target>フランス語（fr）</target>
      </trans-unit>
      <trans-unit id="LanguageIT" resname="LanguageIT">
        <source>Italian (it)</source>
        <target>イタリア語（it）</target>
      </trans-unit>
      <trans-unit id="LanguageJA" resname="LanguageJA">
        <source>Japanese (ja)</source>
        <target>日本語（ja）</target>
      </trans-unit>
      <trans-unit id="Localized_ArabicPlaceholder" resname="Localized_ArabicPlaceholder">
        <source>Imported Arabic text</source>
        <target>読み込んだアラビア語テキスト</target>
      </trans-unit>
      <trans-unit id="Localized_CurrentURL" resname="Localized_CurrentURL">
        <source>Current URL:</source>
        <target>現在のURL：</target>
      </trans-unit>
      <trans-unit id="Localized_ImportArabic" resname="Localized_ImportArabic">
        <source>Import Arabic text</source>
        <target>アラビア語を読み込む</target>
      </trans-unit>
      <trans-unit id="Localized_January" resname="Localized_January">
        <source>January in this language</source>
        <target>この言語での1月の名前</target>
      </trans-unit>
      <trans-unit id="Localized_WindowTitle" resname="Localized_WindowTitle">
        <source>Language: {language}</source>
        <target>表示言語：{language}</target>
      </trans-unit>
      <trans-unit id="Open all in processes" resname="Open all in processes">
        <source>Open all in processes</source>
        <target>全言語を別プロセスで開く</target>
      </trans-unit>
      <trans-unit id="Open single dialog" resname="Open single dialog">
        <source>Open single dialog</source>
        <target>選択した言語で開く</target>
      </trans-unit>
      <trans-unit id="Reveal lang files" resname="Reveal lang files">
        <source>Reveal lang files</source>
        <target>言語ファイルを表示</target>
      </trans-unit>
      <trans-unit id="SET DATABASE LOCALIZATION(Language{;*})" resname="SET DATABASE LOCALIZATION(Language{;*})">
        <source>SET DATABASE LOCALIZATION(Language{;*})</source>
        <target>SET DATABASE LOCALIZATION(Language{;*})</target>
      </trans-unit>
      <trans-unit id="Select language" resname="Select language">
        <source>Select language</source>
        <target>言語の選択</target>
      </trans-unit>
      <trans-unit id="Selected langage is applied on newly opened dialogs" resname="Selected langage is applied on newly opened dialogs">
        <source>The selected language is applied to newly opened dialogs.</source>
        <target>選択した言語は新しく開くダイアログに適用されます。</target>
      </trans-unit>
      <trans-unit id="Table1_WindowTitle" resname="Table1_WindowTitle">
        <source>Imported data</source>
        <target>読み込みデータ</target>
      </trans-unit>
      <trans-unit id="text::set database localization" resname="text::set database localization">
        <source>Change the application's language at runtime using a language code whose .lproj folder exists in Resources.&#13;&#13;Loaded forms keep their labels. The new language is used by forms and strings displayed after the command.</source>
        <target>Resourcesフォルダーにある.lprojフォルダーに対応する言語コードを指定すると、実行中にアプリケーションの言語を切り替えられます。&#13;&#13;読み込み済みのフォームのラベルは変わりません。新しい言語は、コマンド実行後に表示するフォームや文字列に適用されます。</target>
      </trans-unit>
      <trans-unit id="text::set database localization detail" resname="text::set database localization detail">
        <source>SET DATABASE LOCALIZATION(Language)&#13; -&gt; Database and components&#13;&#13;SET DATABASE LOCALIZATION(Language;*)&#13; -&gt; Calling database only&#13;</source>
        <target>SET DATABASE LOCALIZATION(Language)&#13; → データベースとコンポーネント&#13;&#13;SET DATABASE LOCALIZATION(Language;*)&#13; → 呼び出し元のデータベースのみ&#13;</target>
      </trans-unit>
    </body>
  </file>
